<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Distribution for the App Store. If your Xcode rejects this value, use
         "app-store" instead (older alias). -->
    <key>method</key>
    <string>app-store-connect</string>
    <key>teamID</key>
    <string>NKJSLB6HBR</string>
    <key>signingStyle</key>
    <string>automatic</string>
    <key>uploadSymbols</key>
    <true/>
    <key>destination</key>
    <string>export</string>
    <!-- Off, so the IPA carries the build number in Info.plist. On (Xcode's default),
         the export asks App Store Connect and silently renumbers a taken build: a
         1.7.3 (18) archive came out as a 1.7.3 (19) IPA, matching neither git nor
         the tag. A taken number should fail at upload, where it can be seen. -->
    <key>manageAppVersionAndBuildNumber</key>
    <false/>
</dict>
</plist>
