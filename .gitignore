# --- Xcode / xcodegen ---
# NovelReader.xcodeproj is generated from project.yml via `make generate` — not committed.
NovelReader.xcodeproj/
*.xcuserstate
xcuserdata/
DerivedData/

# --- Build output ---
# `build/` is the Makefile's derived data path. `.build/` is nobody's convention here
# — it is SwiftPM's default, and what an ad-hoc `xcodebuild -derivedDataPath .build`
# leaves behind. Once, that was six thousand object files in a commit.
build/
# The live measurement's own path, so a run left going unattended cannot be deleted
# out from under itself by a `make test` started meanwhile — see the Makefile.
build-live/
.build/

