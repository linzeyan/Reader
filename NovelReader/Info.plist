<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Continues a chapter download that backgrounding had to pause. Must match
	     BackgroundDownloads.identifier; iOS traps at registration otherwise. -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.zeyanlin.novelreader.downloads</string>
	</array>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundleDisplayName</key>
	<string>書房</string>
	<!-- "Open with 書房" from Files, Mail or a browser; handled in RootView.
	     Viewer, because the app reads a copy into its own store and never writes
	     back. Alternate, because a reader of imported books has no business
	     taking over as the system's default handler for every .txt on the
	     device — the user's editor should keep that. -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Plain Text Book</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.plain-text</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>EPUB Book</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>org.idpf.epub-container</string>
			</array>
		</dict>
	</array>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.7.1</string>
	<key>CFBundleVersion</key>
	<string>16</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- Required once CFBundleDocumentTypes exists (ITMS-90737): a document app
	     must say whether it can read the file where it lives. Yes, and not because
	     it is the recommended answer — the import path was already written that
	     way. LocalBookImporter takes security-scoped access before reading, and
	     RootView deletes only copies inside our own Documents/Inbox, so a file
	     opened in place is read once and left alone. The alternative would have
	     iOS duplicate a whole novel into that inbox for us to delete afterwards.
	     UISupportsDocumentBrowser stays absent: there is no
	     UIDocumentBrowserViewController here, only "open with 書房". -->
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<!-- User-supplied sources are arbitrary third-party sites, some of which are
	     still HTTP-only. The exception is scoped to WebView content: the app makes
	     no direct URLSession calls to those hosts. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoadsInWebContent</key>
		<true/>
	</dict>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<!-- "processing" rather than an app-refresh window: a paced download of a long
	     book is minutes of work, not seconds, and it is not a background URLSession
	     either — the chapters come through the one WKWebView that holds the site's
	     Cloudflare clearance cookie.

	     "audio" is what lets a book go on being read aloud with the screen locked.
	     It does not lift the limit above: the text a locked phone can read is the
	     text already on disk, because fetching the next chapter still needs that web
	     view and a window to run it in. See `SpeechReader`. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>processing</string>
		<string>audio</string>
	</array>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchScreenBackground</string>
	</dict>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
