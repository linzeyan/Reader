    "settings.background.footer": {
      "comment": "Explains when background downloads run and the two things that stop them.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS looks for a spare moment to continue unfinished chapters while the app is off screen. Under Wi-Fi only it never falls back to cellular in the background. Needs Background App Refresh allowed for this app in Settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App 不在屏幕上时，系统会找空闲时间继续未下载完的章节。“仅 Wi-Fi”在后台不会改用移动网络。需要在“设置 › 通用 › 后台 App 刷新”中允许本 App。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App 不在畫面上時，系統會找空檔繼續未下載完的章節。「僅 Wi-Fi」在背景不會改用行動網路。需要在「設定 › 一般 › 背景 App 重新整理」中允許本 App。"
          }
        }
      }
    },
    "settings.background.never": {
      "comment": "Shown in place of the report when no background download has ever run.",
      "extractionState": "manual",
