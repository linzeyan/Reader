    "derive.warning.heuristicContent": {
      "comment": "Warning: content is located by heuristic rather than a named selector.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The chapter text is located by layout analysis, so a site redesign may require redoing this."
          }
        },
        "zh-Hans": {
