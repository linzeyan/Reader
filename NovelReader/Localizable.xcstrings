    "challenge.explain": {
      "comment": "Explains that the user must complete the check themselves.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This site asks for a human check. Complete it below, then tap Done to continue."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该站点要求人工验证。请在下方完成验证后按“完成”，App 会继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個網站要求人工驗證。請在下方完成驗證後按「完成」，App 會接著繼續。"
          }
        }
      }
    },
