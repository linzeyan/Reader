{
  "sourceLanguage": "zh-Hant",
  "strings": {
    "book.catalog %lld": {
      "comment": "Catalog section header with the chapter count.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chapters (%lld)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目录（%lld 章）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目錄（%lld 章）"
          }
        }
      }
    },
    "book.catalog.empty": {
      "comment": "No chapters could be extracted.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No chapters found. Try refreshing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有获取到章节，试试刷新。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有取得章節，試試重新整理。"
          }
        }
      }
    },
    "book.catalog.loading": {
      "comment": "Shown while the catalog is being fetched.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loading catalog…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在读取目录…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在讀取目錄…"
          }
        }
      }
    },
    "book.catalog.refresh": {
      "comment": "Toolbar button.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refresh catalog"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "刷新目录"
