      },
      "highlights.empty": {
        "comment": "Shown when a book has no highlights yet.",
        "extractionState": "manual",
        "localizations": {
          "en": {
            "stringUnit": {
              "state": "translated",
              "value": "No highlights yet"
            }
          },
          "zh-Hans": {
