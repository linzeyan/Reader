        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "搜尋章節"
          }
        }
      }
    },
    "book.continueReading": {
      "comment": "Primary action when a position was saved.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue Reading"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
