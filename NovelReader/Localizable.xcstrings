    "reader.settings.mode.footer" : {
      "comment" : "Explains how much text each reading mode can mark: a whole paragraph while scrolling, a sentence on a page.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Both modes make highlights and both show the ones you have. Scroll marks a whole paragraph on a long press; Pages marks sentences as you drag, since only a page knows where each character sits."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "两种模式都能划线，也都会显示已有的划线。滚动模式长按一段，划下整段；分页模式长按拖动，划到句子——只有分页排版知道每个字在画面上的位置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "兩種模式都能劃線，也都會顯示已有的劃線。捲動模式長按一段，劃下整段；分頁模式長按拖曳，劃到句子——只有分頁排版知道每個字在畫面上的位置。"
          }
        }
      }
    },
