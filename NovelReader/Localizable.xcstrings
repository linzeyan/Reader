      "comment": "Row label: how many chapters were found.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chapters"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "章节数"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "章節數"
          }
        }
      }
    },
    "derive.error.badURL": {
      "comment": "Error: the pasted text is not a usable web address.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That is not a usable web address."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这不是一个可用的网址。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這不是一個可用的網址。"
          }
        }
      }
    },
    "derive.error.emptyChapter": {
      "comment": "Error: a chapter opened but no text came out.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No text could be extracted from a chapter, so a rule cannot be worked out for this site."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "章节内容抓不到文字，这个站台目前无法自动创建规则。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "章節內容抓不到文字，這個站台目前無法自動建立規則。"
          }
        }
      }
    },
    "derive.error.noChapterLinks": {
      "comment": "Error: no chapter list could be found on the page.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No chapter list was found on this page. Try the book's own page, or its table of contents."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在这一页找不到章节清单。请改贴书籍页或目录页的网址。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在這一頁找不到章節清單。請改貼書籍頁或目錄頁的網址。"
          }
        }
      }
    },
    "derive.error.noTitle": {
      "comment": "Error: the page has no readable book title.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No book title could be read; this may not be a book page."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读不出书名，这一页可能不是书籍页。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讀不出書名，這一頁可能不是書籍頁。"
          }
        }
      }
    },
    "derive.firstChapter": {
      "comment": "Row label: the first chapter's title.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "First chapter"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第一章"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "第一章"
          }
        }
      }
    },
    "derive.footer": {
      "comment": "Explains what to paste and what happens next.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste the address of any book's page. The page is opened for real, a rule for the site is worked out from it, and you confirm the result before anything is saved."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "粘贴任一本书的书籍页网址。App 会实际打开该页，推导出这个站台的规则，并先让你确认结果。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "貼上任一本書的書籍頁網址。App 會實際打開該頁，推導出這個站台的規則，並先讓你確認結果。"
          }
        }
      }
    },
    "derive.host": {
      "comment": "Row label: the site this rule covers.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Site"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "站台"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "站台"
          }
        }
