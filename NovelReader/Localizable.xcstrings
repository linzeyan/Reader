    "book.missingRule": {
      "comment": "The bookmark's source rule is no longer installed.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This book's source rule was removed. Re-add it to keep reading."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该书的来源规则已被移除，重新添加后即可继续阅读。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這本書的來源規則已被移除，重新加入後即可繼續閱讀。"
          }
        }
      }
    },
    "book.startReading": {
      "comment": "Primary action when there is no saved position.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start Reading"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始阅读"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開始閱讀"
          }
        }
      }
