        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "繼續閱讀"
          }
        }
      }
    },
    "book.deleteDownloads": {
      "comment": "Requirement 4.3, book scope.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete Downloads"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除本书下载"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除本書下載"
          }
        }
      }
    },
    "book.download.pause": {
      "comment": "Pauses the download queue.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause"
          }
        },
        "zh-Hans": {
