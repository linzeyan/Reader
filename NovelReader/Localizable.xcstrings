    "bookmarks.empty.hint": {
      "comment": "Tells the reader where bookmarks are created: the reader's control bar.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While reading, tap the page to show the controls, then tap the bookmark button to save where you are."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "阅读时点一下画面叫出控制栏，再按书签就能把当前位置存起来。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "閱讀時點一下畫面叫出控制列，再按書籤就能把目前位置存起來。"
          }
        }
      }
    },
      "reader.settings.mode": {
        "comment": "Picker label for how the reader turns text: one continuous scroll, or fixed pages.",
